#!/bin/bash


############################################################
# Activate environment
############################################################

module purge all
module load python-anaconda3/2019.10
# source activate 
medaka --version

############################################################
# User-defined variables
############################################################
samples=("-BarcodeID")
SAMPLE=${samples[$SLURM_ARRAY_TASK_ID]}

READS="-filtlong output"

ASSEMBLY="-fyle output"

OUTDIR="-output"

############################################################
# Create output directory
############################################################

mkdir -p ${OUTDIR}

############################################################
# Run Medaka
############################################################

medaka_consensus \
    -i ${READS} \
    -d ${ASSEMBLY} \
    -o ${OUTDIR} \
    -t ${SLURM_CPUS_PER_TASK}

echo "Medaka completed."
